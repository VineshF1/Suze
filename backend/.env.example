# NVIDIA NIM API key (get from https://build.nvidia.com)
# Required for LLM chat and embeddings
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE

# Model selection (defaults work with NVIDIA NIM)
EMBED_MODEL=nvidia/nv-embed-v1
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Server
HOST=0.0.0.0
PORT=8000
